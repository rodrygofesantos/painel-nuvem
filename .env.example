# Copie este arquivo para ".env" caso queira personalizar valores localmente.
# O arquivo ".env" nunca deve ser enviado ao Git (ele já está no .gitignore).

# Porta em que o servidor HTTP escuta dentro do contêiner/máquina local.
PORT=3000

# Nome exibido na interface e retornado pelo endpoint /api/info.
APP_NAME=Painel de Implantação em Nuvem

# Versão da aplicação exibida na interface e usada durante o laboratório
# para demonstrar a atualização de v1.0 para v1.1.
APP_VERSION=v1.0

# Ambiente em que a aplicação está sendo executada (ex: local, AKS Automatic).
APP_ENVIRONMENT=local
